    "/v1/assets/{dataSourceId}/complete": {
      "post": {
        "tags": [
          "Assets"
        ],
        "summary": "Confirm asset uploads and create the files",
        "description": "Confirms the uploads and creates the files. At most 50 assets per call.\n\nOcctoo reads each blob back, creates the media file and updates the data source entry behind the entry key. Each asset must carry the same filename it was initialized under — a different name points at a blob that doesn't exist, and that entry key comes back under `failed`.",
        "operationId": "completeAssets",
        "parameters": [
          {
            "name": "dataSourceId",
            "in": "path",
            "description": "Stable customer-facing source id within the authenticated tenant.",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string",
              "example": "product-images"
            },
            "example": "product-images"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteAssetsRequest"
              },
              "examples": {
                "example": {
                  "summary": "Complete one upload",
                  "value": {
                    "assets": [
                      {
                        "entryKey": "sku-1",
                        "filename": "front.jpg"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The file created for each entry key that could be completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletedAssets"
                },
                "examples": {
                  "example": {
                    "summary": "The file Occtoo read back off the blob",
                    "value": {
                      "completed": {
                        "sku-1": {
                          "filename": "front.jpg",
                          "mimeType": "image/jpeg",
                          "size": 120432,
                          "publicUrl": "https://cdn.occtoo-media.com/6b1f0b3c-6f2e-4a52-9a1e-7c6f0c2f9a10/9c2a7d18-4f6b-4f0b-9a2a-2f2e6c7d8e90/front.jpg",
                          "width": 1200,
                          "height": 800
                        }
                      },
                      "failed": { }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
