    "/v1/assets/{dataSourceId}/uploadLinks": {
      "post": {
        "tags": [
          "Assets"
        ],
        "summary": "Get fresh upload links for assets that are already initialized",
        "description": "Signs a fresh upload link for already-initialized assets, for a caller whose link expired or never arrived. At most 50 assets per call.\n\nAn entry key that was never initialized, or that's already completed, comes back under `failed`. Replacing a completed file means deleting the asset and initializing it again.",
        "operationId": "createAssetUploadLinks",
        "parameters": [
          {
            "name": "dataSourceId",
            "in": "path",
            "description": "Stable customer-facing source id within the authenticated tenant.",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string",
              "example": "product-images"
            },
            "example": "product-images"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadLinksRequest"
              },
              "examples": {
                "example": {
                  "summary": "Re-sign one asset",
                  "value": {
                    "assets": [
                      {
                        "entryKey": "sku-1",
                        "filename": "front.jpg"
                      }
                    ]
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A fresh upload link per eligible entry key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitializedAssets"
                },
                "examples": {
                  "example": {
                    "summary": "A fresh link, and a key that could not be signed",
                    "value": {
                      "initialized": {
                        "sku-1": {
                          "uploadUrl": "https://occtoomedia.blob.core.windows.net/6b1f0b3c/9c2a7d18/front.jpg?sv=2024-11-04&se=...&sig=...",
                          "expiresAt": "2026-09-25T13:30:00+00:00"
                        }
                      },
                      "failed": {
                        "sku-2": "Asset is not initialized"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
