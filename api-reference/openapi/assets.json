  "components": {
    "schemas": {
      "AssetInitialization": {
        "required": [
          "uploadUrl",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "uploadUrl": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AssetState": {
        "required": [
          "status",
          "filename",
          "mimeType",
          "size",
          "publicUrl"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AssetStatus"
          },
          "filename": {
            "type": [
              "null",
              "string"
            ]
          },
          "mimeType": {
            "type": [
              "null",
              "string"
            ]
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "publicUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AssetStatus": {
        "enum": [
          "Initialized",
          "Completed",
          "Failed"
        ]
      },
      "AssetToInitialize": {
        "required": [
          "entryKey",
          "filename"
        ],
