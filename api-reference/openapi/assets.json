            "name": "dataSourceId",
            "in": "path",
            "description": "Stable customer-facing source id within the authenticated tenant.",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string",
              "example": "product-images"
            },
            "example": "product-images"
          },
          {
            "name": "key",
            "in": "query",
            "description": "Entry key to act on. Repeat the parameter for several keys: `?key=sku-1&key=sku-2`. At most 50 per call.",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": "sku-1"
          }
        ],
        "responses": {
          "200": {
            "description": "The state of every requested entry key that has an asset.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/components/schemas/AssetState"
                  }
                },
                "examples": {
                  "example": {
                    "summary": "One completed asset",
                    "value": {
                      "sku-1": {
                        "status": "Completed",
                        "filename": "front.jpg",
                        "mimeType": "image/jpeg",
                        "size": 120432,
                        "publicUrl": "https://cdn.occtoo-media.com/6b1f0b3c-6f2e-4a52-9a1e-7c6f0c2f9a10/9c2a7d18-4f6b-4f0b-9a2a-2f2e6c7d8e90/front.jpg"
